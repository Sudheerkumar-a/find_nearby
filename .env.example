# Copy this file to .env and fill in your keys.
# Never commit .env — it is gitignored.
# Both .env and .env.example are Flutter assets (see pubspec.yaml).

# mock | google | geoapify | automatic (hybrid)
# automatic = Google + Geoapify in parallel when keys exist
# Use geoapify or automatic when GEOAPIFY_API_KEY is set — mock ignores the key.
PLACE_PROVIDER=geoapify

# Google Places API (New) key. Restrict it to Places API in Google Cloud.
GOOGLE_PLACES_API_KEY=

# Optional separate Maps key. Restrict it to Maps SDK for Android / iOS.
GOOGLE_MAPS_API_KEY=

# Geoapify Places / Place Details key. Restrict per Geoapify dashboard guidance.
# Docs: https://apidocs.geoapify.com/
GEOAPIFY_API_KEY=
